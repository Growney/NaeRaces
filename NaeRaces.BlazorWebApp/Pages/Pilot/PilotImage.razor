@code {
    [Parameter]
    public MudBlazor.Utilities.MudColor? GoggleColour { get; set; }
    [Parameter]
    public MudBlazor.Utilities.MudColor? SkinColour { get; set; }
    [Parameter]
    public MudBlazor.Utilities.MudColor? TopColour { get; set; }

    [Parameter]
    public MudBlazor.Color? ThemeGoggleColour { get; set; }
    [Parameter]
    public MudBlazor.Color? ThemeSkinColour { get; set; }
    [Parameter]
    public MudBlazor.Color? ThemeTopColour { get; set; }


    private string _goggleColour = "#000000";
    private string _skinColour = "#000000";
    private string _topColour = "#000000";

    protected override void OnParametersSet()
    {
        _goggleColour = GetColorString(GoggleColour, ThemeGoggleColour, Color.Tertiary);
        _skinColour = GetColorString(SkinColour, ThemeSkinColour, Color.Secondary);
        _topColour = GetColorString(TopColour, ThemeTopColour, Color.Dark);
        base.OnInitialized();
    }

    private string GetColorString(MudBlazor.Utilities.MudColor? colourClass, MudBlazor.Color? themeColour, MudBlazor.Color defaultThemeColour)
    {
        if (colourClass is not null)
        {
            return colourClass.ToString(MudBlazor.Utilities.MudColorOutputFormats.HexA);
        }

        MudBlazor.Color resolvedThemeColour = themeColour ?? defaultThemeColour;

        return $"var(--mud-palette-{resolvedThemeColour.ToString().ToLower()})";

    }
}
