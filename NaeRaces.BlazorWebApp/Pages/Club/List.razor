@page "/clubs"
@page "/"
@using NaeRaces.WebAPI.Shared.Club

    @if (_clubs == null || !_clubs.Any())
{
    <MudText>Getting clubs</MudText>
}
else
{
    <MudSimpleTable Hover="true">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Members</th>
                <th>Following</th>
                <th>Membership</th>
                <th>Follow</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var club in _clubs)
            {
                <tr @onclick="()=>NavigateToClub(club.ClubId)">
                    <td>@club.ClubCode</td>
                    <td>@club.ClubName</td>
                    <td>@club.Members</td>
                    <td>@club.Followers</td>
                    <td>
                        @if ((club.IsMembershipConfirmed.HasValue && club.IsMembershipConfirmed.Value) && club.MembershipExpiry.HasValue)
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Expires: @club.MembershipExpiry.Value.ToShortDateString()</MudChip>
                        }
                        else if ((club.IsMembershipConfirmed.HasValue && !club.IsMembershipConfirmed.Value) && !string.IsNullOrEmpty(club.MembershipLevelName))
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">Pending</MudChip>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary">Join</MudButton>
                        }
                    </td>
                    <td>
                        <FollowClubButton ClubId="club.ClubId" IsFollowing="club.IsFollowing"></FollowClubButton>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}
<div class="d-flex flex-row-reverse">
    <MudButton EndIcon="@Icons.Material.Filled.ArrowRightAlt" Color="Color.Primary" Href="/club/create">Nae clubs? Click here to create your own!</MudButton>
</div>

@code {
    private IEnumerable<ClubWithMembershipResponse>? _clubs = null;

    [Parameter]
    [SupplyParameterFromQuery(Name = "followed-club")]
    public Guid? FollowedClubId { get; set; }

    [Inject]
    public HttpClient Http { get; set; } = null!;
    [Inject]
    public NavigationManager Navigation { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        _clubs = await Http.GetFromJsonAsync<IEnumerable<ClubWithMembershipResponse>>("api/club/query/all-with-membership");

        //This is to ensure that when the callback comes from following a club that the club we followed is set to true despite the query side not having caught up.
        if (FollowedClubId.HasValue)
        {
            var club = _clubs?.FirstOrDefault(x => x.ClubId == FollowedClubId.Value);
            if (club != null)
            {
                club.IsFollowing = true;
            }
        }
    }

    private async Task UnfollowClubAsync(Guid clubId)
    {
        var response = await Http.DeleteAsync($"api/pilot/follow/{clubId}");
        if (response.IsSuccessStatusCode)
        {
            var club = _clubs?.FirstOrDefault(x => x.ClubId == clubId);
            if (club != null)
            {
                club.IsFollowing = false;
            }
        }
    }

    private void NavigateToClub(Guid clubId)
    {
        Navigation.NavigateTo($"club/{clubId}");
    }
}
