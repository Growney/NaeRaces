@page "/club/create"
@attribute [Authorize]
@using NaeRaces.WebAPI.Shared.Club
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Create Club</PageTitle>

<MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors" OnEnterPressed="@(() => _form.ValidateAsync())" >
    <MudText Typo="Typo.h4">Create Club</MudText>
    <MudText Typo="Typo.caption">Enter the details for your new club. You will become the club administrator.</MudText>

    <MudTextField @bind-Value="request.Code" Required=true Label="Code" HelperText="A short unique identifier for the club." RequiredError="Code is required"></MudTextField>
    <MudTextField @bind-Value="request.Name" Required=true Label="Name" HelperText="e.g. NAE FPV Club" RequiredError="Name is required"></MudTextField>

    <div class="d-flex flex-row-reverse gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="()=> CreateAsync()">Create Club</MudButton>
    </div>
</MudForm>

@code {
    private MudForm? _form;
    private bool _success;
    private string[] _errors = [];

    private readonly CreateClubRequest request = new();
    private bool isSubmitting;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        request.ClubId = Guid.NewGuid();
    }

    private async Task CreateAsync()
    {
        if(_form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/club", request);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo($"/club/edit/{request.ClubId}");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = "A club with the same code or name already exists.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
            {
                errorMessage = "Invalid request. Please check the club code and name.";
            }
            else
            {
                errorMessage = "Failed to create club. Please try again.";
            }
        }
        catch
        {
            errorMessage = "An error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
