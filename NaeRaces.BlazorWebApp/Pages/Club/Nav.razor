@using NaeRaces.WebAPI.Shared.Club
<MudGrid Justify="Justify.SpaceBetween">
    <MudItem xs="5">
        <MudItem>
            <MudText Typo="Typo.h3">@ClubName</MudText>
        </MudItem>
    </MudItem>
    <MudItem xs="7">
        <MudGrid Justify="Justify.FlexEnd" Class="mt-auto">
            <MudItem>
                <FollowClubButton FollowVariant="Variant.Text" UnfollowVariant="Variant.Text" IsFollowing="_isFollowing" ClubId="ClubId"></FollowClubButton>
            </MudItem>
            <MudItem>
                <MudButton href=@($"club/{ClubId}/join") class="btn btn-outline-primary">Join</MudButton>
            </MudItem>
            <MudItem>
                <MudButton href=@($"club/{ClubId}/news")>News</MudButton>
            </MudItem>
            <MudItem>
                <MudButton href=@($"club/{ClubId}/about") class="btn btn-outline-secondary">About</MudButton>
            </MudItem>
            <MudItem>
                <MudButton href=@($"club/{ClubId}/contact") class="btn btn-outline-secondary">Contact</MudButton>
            </MudItem>
            <MudItem>
                <MudButton href=@($"club/{ClubId}/members") class="btn btn-outline-secondary">Members</MudButton>
            </MudItem>
            <MudItem>
                <MudButton href=@($"club/{ClubId}/events") class="btn btn-outline-secondary">Events</MudButton>
            </MudItem>
        </MudGrid>
    </MudItem>
</MudGrid>


@code {

    [Parameter]
    [EditorRequired]
    public Guid ClubId { get; set; }
    [Parameter]
    [EditorRequired]
    public string ClubName { get; set; }
    [Parameter]
    public string? Overview { get; set; }
    [Parameter]
    public bool IsFollowing { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    [Inject]
    public HttpClient Http { get; set; } = null!;
    [Inject]
    public NavigationManager NavigationManager { get; set; } = null!;

    private ClubOverviewResponse? overview;
    private bool _isTogglingFollow;
    private bool _isAuthenticated;
    private bool _isFollowing;

    protected override Task OnParametersSetAsync()
    {
        _isFollowing = IsFollowing;
        Console.WriteLine(_isFollowing.ToString());
        return base.OnParametersSetAsync();
    }

    private async Task FollowClubAsync()
    {
        var user = (await AuthenticationStateTask).User;
        if (!user?.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo($"authentication/login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}");
            return;
        }

        _isTogglingFollow = true;
        try
        {
            var response = await Http.PostAsync($"api/pilot/follow/{ClubId}", null);
            if (response.IsSuccessStatusCode)
            {
                _isFollowing = true;
            }
        }
        catch { }
        finally
        {
            _isTogglingFollow = false;
        }
    }

    private async Task UnfollowClubAsync()
    {
        var user = (await AuthenticationStateTask).User;
        if (!user?.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo($"authentication/login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}");
            return;
        }

        _isTogglingFollow = true;
        try
        {
            var response = await Http.DeleteAsync($"api/pilot/follow/{ClubId}");
            if (response.IsSuccessStatusCode)
            {
                _isFollowing = false;
            }
        }
        catch
        {

        }
        finally
        {
            _isTogglingFollow = false;
        }
    }
}
