@page "/club/{ClubId:guid}/members"
@using NaeRaces.WebAPI.Shared.Club;
@layout ClubLayout

@if (_groupedMembers is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <MudText Typo="Typo.h4">Leadership</MudText>
    @if (_membersWithRoles.Any())
    {
        <MudGrid>
            @foreach (var member in _membersWithRoles)
            {
                <MudItem xs="12" md="6" lg="4">
                    <ClubMemberCard PilotId="@member.PilotId" CallSign="@member.CallSign" Name="@member.Name" Nationality="@member.Nationality"
                                    Email="@member.Email" DateOfBirth="@member.DateOfBirth" MembershipLevelId="@member.MembershipLevelId" MembershipLevelName="@member.MembershipLevelName"
                                    PaymentOptionId="@member.PaymentOptionId" PaymentOptionName="@member.PaymentOptionName" ValidUntil="@member.ValidUntil" MemberSince="@member.MemberSince"
                                    Roles="@member.Roles"></ClubMemberCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <p>Club has no leadership</p>
    }
    <MudText Typo="Typo.h4">Members</MudText>
    @if (_membersWithoutRoles.Any())
    {
        <MudGrid>
            @foreach(var member in _membersWithoutRoles)
            {
                <MudItem>
                    <ClubMemberCard PilotId="@member.PilotId" CallSign="@member.CallSign" Name="@member.Name" Nationality="@member.Nationality" 
                    Email="@member.Email" DateOfBirth="@member.DateOfBirth" MembershipLevelId="@member.MembershipLevelId" MembershipLevelName="@member.MembershipLevelName"
                    PaymentOptionId="@member.PaymentOptionId" PaymentOptionName="@member.PaymentOptionName" ValidUntil="@member.ValidUntil" MemberSince="@member.MemberSince"
                    Roles="@member.Roles"></ClubMemberCard>
                </MudItem>
            }
        </MudGrid>
    }
    else
    {
        <p>Club has no members</p>
    }
}

@code {
    [Parameter]
    public Guid ClubId { get; set; }
    [Inject]
    public HttpClient HttpClient { get; set; } = default!;

    private IEnumerable<IGrouping<bool, ClubMemberDetailResponse>>? _groupedMembers;
    private IEnumerable<ClubMemberDetailResponse> _membersWithRoles => _groupedMembers?.Where(x => x.Key).SelectMany(x => x) ?? Enumerable.Empty<ClubMemberDetailResponse>();
    private IEnumerable<ClubMemberDetailResponse> _membersWithoutRoles => _groupedMembers?.Where(x => !x.Key).SelectMany(x => x) ?? Enumerable.Empty<ClubMemberDetailResponse>();

    protected override async Task OnInitializedAsync()
    {
        HttpRequestMessage membersMessage = new(HttpMethod.Get, $"api/club/{ClubId}/query/members/details");

        HttpResponseMessage response = await HttpClient.SendAsync(membersMessage);

        if (response.IsSuccessStatusCode)
        {
            var members = await response.Content.ReadFromJsonAsync<List<ClubMemberDetailResponse>>();
            if (members != null)
            {
                _groupedMembers = members.GroupBy(m => m.Roles.Any());
            }
        }

        await base.OnInitializedAsync();
    }
}
