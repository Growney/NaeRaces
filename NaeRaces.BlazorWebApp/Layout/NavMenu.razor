<nav >
    <div class="navbar-inner">
        @if (_isDarkMode)
        {
            <a class="navbar-brand" href=""> <img style="max-height:2.5em" src="img/NaeRaces - Dark.png" alt="NaeRaces" /> </a>
        }
        else
        {
            <a class="navbar-brand" href=""> <img style="max-height:2.5em" src="img/NaeRaces - Light.png" alt="NaeRaces" /> </a>
        }
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@NavMenuCssClass navbar-collapse">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="">
                        <i class="fa-solid fa-people-group"></i> Clubs
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="races">
                        <i class="fa-solid fa-flag-checkered"></i> Races
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="series">
                        <i class="fa-solid fa-flag-checkered"></i> Series
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="pilots">
                        <i class="fa-solid fa-user"></i> Pilots
                    </a>
                </li>
            </ul>
            <div class="navbar-login">
                <MudThemeProvider @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" />
                <MudSwitch @bind-Value="_isDarkMode" Color="Color.Primary" Class="ma-4" T="bool" Label="Toggle Light/Dark Mode" />
                <LoginDisplay />
            </div>
        </div>
    </div>
</nav>

@code {

    private bool _isDarkMode;
    private MudThemeProvider? _mudThemeProvider;

    private bool collapseNavMenu = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if(_mudThemeProvider is not null)
            {     
                _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
                StateHasChanged();
            }
        }
        
    }
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
