@inherits LayoutComponentBase
<PageTitle>NaeRaces</PageTitle>
<MudLayout>
    <MudPopoverProvider />
    <MudThemeProvider Theme="_theme" @ref="_mudThemeProvider" @bind-IsDarkMode="_isDarkMode" />
    <MudAppBar>
        <div>
            <a class="navbar-brand" href=""> <img style="max-height:2.5em" src="img/Logo.png" alt="NaeRaces" /> </a>
        </div>
        <div class="d-flex justify-space-between" style="width: 100%">
            <div class="d-flex">
                <MudNavLink IconColor="Color.Primary" Icon="@Icons.Material.Filled.People" Href="">Clubs</MudNavLink>
                <MudNavLink IconColor="Color.Primary" Icon="@Icons.Material.Filled.Flag" Href="races">Races</MudNavLink>
                <MudNavLink IconColor="Color.Primary" Icon="@Icons.Material.Filled.FlagCircle" Href="series">Series</MudNavLink>
                <MudNavLink IconColor="Color.Primary" Icon="@Icons.Material.Filled.Person" Href="pilots">Pilots</MudNavLink>
            </div>
            <div class="d-flex">
                <MudSwitch T=bool ThumbIconColor="Color.Primary" ThumbIcon="@(_isDarkMode ? @Icons.Material.Filled.LightMode : @Icons.Material.Filled.DarkMode)" @bind-Value="_isDarkMode"></MudSwitch>
                <AuthorizeView>
                    <Authorized>
                        <MudNavLink Style="white-space: nowrap;" Href="@($"/pilot/{context.User.Claims.First(x => x.Type == "sub").Value}/profile")">@context.User.Identity!.Name</MudNavLink>
                        <MudNavLink IconColor="Color.Primary" Icon="@Icons.Material.Filled.Logout" OnClick="BeginSignOut"></MudNavLink>
                    </Authorized>
                    <NotAuthorized>
                        <MudNavLink @onclick="NavigateToRegister">Register</MudNavLink>
                        <MudNavLink @onclick="NavigateToLogin">Log in</MudNavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </MudAppBar>

    <MudMainContent Class="mt-4">
        <MudContainer MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    private bool _isDarkMode;
    private MudThemeProvider? _mudThemeProvider;
    private MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark()
        {
            AppbarBackground = Colors.DeepPurple.Darken4,
            Primary = new MudBlazor.Utilities.MudColor("#f57c00"),
            Secondary = new MudBlazor.Utilities.MudColor("#915afb"),
            Tertiary = new MudBlazor.Utilities.MudColor("#00f57c"),
            AppbarText = Colors.Gray.Lighten5,
            TextPrimary = Colors.Gray.Lighten5,

        },
        PaletteLight = new PaletteLight()
        {
            AppbarBackground = Colors.DeepPurple.Darken4,
            Primary = new MudBlazor.Utilities.MudColor("#f57c00"),
            Secondary = new MudBlazor.Utilities.MudColor("#915afb"),
            Tertiary = new MudBlazor.Utilities.MudColor("#00f57c"),
        }
    };

    private bool collapseNavMenu = true;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;
    [Inject]
    private IConfiguration Configuration { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (_mudThemeProvider is not null)
            {
                _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
                StateHasChanged();
            }
        }

    }
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void NavigateToRegister()
    {
        var apiBase = Configuration["ApiSettings:BaseAddress"];

        if (string.IsNullOrWhiteSpace(apiBase))
        {
            apiBase = Navigation.BaseUri;
        }

        var baseUri = apiBase.TrimEnd('/');
        Navigation.NavigateTo($"{baseUri}/Identity/Account/Register?returnUrl={Navigation.BaseUri}", forceLoad: true);
    }
    private void NavigateToLogin()
    {
        var relativeReturnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        relativeReturnUrl = string.IsNullOrWhiteSpace(relativeReturnUrl)
            ? "/"
            : $"/{relativeReturnUrl}";

        Navigation.NavigateToLogin("authentication/login", new InteractiveRequestOptions
        {
            Interaction = InteractionType.SignIn,
            ReturnUrl = relativeReturnUrl
        });
    }

    private void BeginSignOut(MouseEventArgs args)
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}
